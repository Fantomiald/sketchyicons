{
  "name": "sketchyicons-repo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "generate": "node tools/roughen-icons.mjs",
    "preview": "node tools/build-preview.mjs --split 440",
    "tune": "node tools/build-tuner.mjs",
    "build": "pnpm -r --filter \"./packages/**\" build",
    "test": "vitest run",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publint": "pnpm -r --filter \"./packages/**\" publint",
    "attw": "pnpm -r --filter \"./packages/**\" attw",
    "size": "size-limit",
    "changeset": "changeset",
    "prepare": "husky"
  },
  "devDependencies": {
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.19",
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@size-limit/preset-small-lib": "11.2.0",
    "@types/node": "20.19.43",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "happy-dom": "20.11.1",
    "husky": "9.1.7",
    "lucide-static": "1.27.0",
    "preact": "10.29.7",
    "preact-render-to-string": "6.6.4",
    "prettier": "3.9.6",
    "publint": "0.3.22",
    "size-limit": "11.2.0",
    "solid-js": "1.9.14",
    "svelte": "5.56.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "vue": "3.5.40"
  }
}
